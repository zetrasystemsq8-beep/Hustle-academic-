class GradientFill extends PaintFill {
  final GradientType gradientType;
  final Vec2D startPoint;
  final Vec2D endPoint;
  final List<GradientStop> stops;
  final double focalRadius; // For radial gradients

  GradientFill({
    required this.gradientType,
    required this.startPoint,
    required this.endPoint,
    required this.stops,
    this.focalRadius = 0.0,
  });

  ColorRGBA colorAt(double t) {
    if (stops.isEmpty) return ColorRGBA.black;
    if (stops.length == 1) return stops.first.color;
    if (t <= stops.first.offset) return stops.first.color;
    if (t >= stops.last.offset) return stops.last.color;

    for (int i = 0; i < stops.length - 1; i++) {
      if (t >= stops[i].offset && t <= stops[i + 1].offset) {
        final localT = (t - stops[i].offset) / (stops[i + 1].offset - stops[i].offset);
        return stops[i].color.lerp(stops[i + 1].color, localT);
      }
    }
    return stops.last.color;
  }

  @override
  Map<String, dynamic> toJson() => {
        'type': 'gradient',
        'gradientType': gradientType.name,
        'startPoint': startPoint.toJson(),
        'endPoint': endPoint.toJson(),
        'stops': stops.map((s) => s.toJson()).toList(),
        'focalRadius': focalRadius,
      };

  factory GradientFill.fromJson(Map<String, dynamic> json) {
    return GradientFill(
      gradientType: GradientType.values.byName(json['gradientType']),
      startPoint: Vec2D.fromJson(json['startPoint']),
      endPoint: Vec2D.fromJson(json['endPoint']),
      stops: (json['stops'] as List).map((s) => GradientStop.fromJson(s)).toList(),
      focalRadius: (json['focalRadius'] as num).toDouble(),
    );
  }
}

