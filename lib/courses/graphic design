/// Abstract base class for scene graph design nodes.
abstract class DesignNode {
  String id;
  String name;
  bool visible;
  bool locked;
  double opacity;
  BlendMode blendMode;
  Matrix2D transform;
  DropShadow? shadow;

  DesignNode({
    required this.id,
    required this.name,
    this.visible = true,
    this.locked = false,
    this.opacity = 1.0,
    this.blendMode = BlendMode.normal,
    Matrix2D? transform,
    this.shadow,
  }) : transform = transform ?? Matrix2D.identity();

  Rect2D get localBounds;
  Rect2D get globalBounds => transform.transformRect(localBounds);

  bool containsPoint(Vec2D point) {
    final inverted = transform.invert();
    if (inverted == null) return false;
    final localPoint = inverted.transformPoint(point);
    return localBounds.containsPoint(localPoint);
  }

  Map<String, dynamic> toJson();
}

/// Vector Shape Node representing paths, polygons, bezier curves with fill/stroke styling.
class VectorShapeNode extends DesignNode {
  Path2D path;
  PaintFill? fill;
  StrokeStyle? stroke;

  VectorShapeNode({
    required String id,
    required String name,
    required this.path,
    this.fill,
    this.stroke,
    bool visible = true,
    bool locked = false,
    double opacity = 1.0,
    BlendMode blendMode = BlendMode.normal,
    Matrix2D? transform,
