/// Text Node representing dynamic vector layout typography.
class TextNode extends DesignNode {
  String text;
  String fontFamily;
  double fontSize;
  double fontWeight; // 100 to 900
  double letterSpacing;
  double lineHeight;
  TextAlignment alignment;
  PaintFill fill;
  StrokeStyle? stroke;

  TextNode({
    required String id,
    required String name,
    required this.text,
    this.fontFamily = 'Inter',
    this.fontSize = 16.0,
    this.fontWeight = 400,
    this.letterSpacing = 0.0,
    this.lineHeight = 1.2,
    this.alignment = TextAlignment.left,
    required this.fill,
    this.stroke,
    bool visible = true,
    bool locked = false,
    double opacity = 1.0,
    BlendMode blendMode = BlendMode.normal,
    Matrix2D? transform,
    DropShadow? shadow,
  }) : super(
          id: id,
          name: name,
          visible: visible,
          locked: locked,
          opacity: opacity,
          blendMode: blendMode,
          transform: transform,
          shadow: shadow,
        );

  @override
  Rect2D get localBounds {
    // Estimating typographic layout bounding box
    final lines = text.split('\n');
    double maxWidth = 0.0;
    for (final line in lines) {
      final width = line.length * (fontSize * 0.6) + (line.length * letterSpacing);
      maxWidth = math.max(maxWidth, width);
    }
    final height = lines.length * (fontSize * lineHeight);
    return Rect2D(0, 0, maxWidth, height);
  }

  @override
  Map<String, dynamic> toJson() => {
        'type': 'text',
        'id': id,
        'name': name,
        'visible': visible,
        'locked': locked,
        'opacity': opacity,
        'blendMode': blendMode.name,
        'transform': transform.toJson(),
        'shadow': shadow?.toJson(),
        'text': text,
        'fontFamily': fontFamily,
        'fontSize': fontSize,
        'fontWeight': fontWeight,
        'letterSpacing': letterSpacing,
        'lineHeight': lineHeight,
        'alignment': alignment.name,
        'fill': fill.toJson(),
        'stroke': stroke?.toJson(),
      };

  factory TextNode.fromJson(Map<String, dynamic> json) {
    return TextNode(
      id: json['id'],
