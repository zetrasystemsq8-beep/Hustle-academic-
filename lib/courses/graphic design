/// Comprehensive Vector Path representation with boolean operations support and curve sampling.
class Path2D {
  final List<PathCommand> commands = [];

  Path2D();

  void moveTo(double x, double y) {
    commands.add(PathCommand(type: PathCommandType.moveTo, target: Vec2D(x, y)));
  }

  void lineTo(double x, double y) {
    commands.add(PathCommand(type: PathCommandType.lineTo, target: Vec2D(x, y)));
  }

  void quadTo(double x1, double y1, double x2, double y2) {
    commands.add(PathCommand(
      type: PathCommandType.quadTo,
      target: Vec2D(x2, y2),
      control1: Vec2D(x1, y1),
    ));
  }

  void cubicTo(double x1, double y1, double x2, double y2, double x3, double y3) {
    commands.add(PathCommand(
      type: PathCommandType.cubicTo,
      target: Vec2D(x3, y3),
      control1: Vec2D(x1, y1),
      control2: Vec2D(x2, y2),
    ));
  }

  void close() {
    commands.add(const PathCommand(type: PathCommandType.close, target: Vec2D(0, 0)));
  }

  void addRect(Rect2D rect) {
    moveTo(rect.minX, rect.minY);
    lineTo(rect.maxX, rect.minY);
    lineTo(rect.maxX, rect.maxY);
    lineTo(rect.minX, rect.maxY);
    close();
  }

  void addCircle(Vec2D center, double radius) {
    final k = 0.552284749831 * radius;
    moveTo(center.x + radius, center.y);
    cubicTo(center.x + radius, center.y + k, center.x + k, center.y + radius, center.x, center.y + radius);
    cubicTo(center.x - k, center.y + radius, center.x - radius, center.y + k, center.x - radius, center.y);
    cubicTo(center.x - radius, center.y - k, center.x - k, center.y - radius, center.x, center.y - radius);
    cubicTo(center.x + k, center.y - radius, center.x + radius, center.y - k, center.x + radius, center.y);
    close();
  }

  void addPolygon(List<Vec2D> points) {
    if (points.isEmpty) return;
    moveTo(points.first.x, points.first.y);
    for (int i = 1; i < points.length; i++) {
      lineTo(points[i].x, points[i].y);
    }
    close();
  }

  Rect2D get boundingBox {
    if (commands.isEmpty) return Rect2D.zero;

    double minX = double.infinity;
    double minY = double.infinity;
    double maxX = -double.infinity;
    double maxY = -double.infinity;

    Vec2D current = Vec2D.zero;

    for (final cmd in commands) {
      switch (cmd.type) {
        case PathCommandType.moveTo:
        case PathCommandType.lineTo:
          current = cmd.target;
          minX = math.min(minX, current.x);
          minY = math.min(minY, current.y);
          maxX = math.max(maxX, current.x);
          maxY = math.max(maxY, current.y);
          break;
        case PathCommandType.quadTo:
          // Elevate quad to cubic for uniform bounding box solving
          final c1 = current + (cmd.control1 - current) * (2.0 / 3.0);
          final c2 = cmd.target + (cmd.control1 - cmd.target) * (2.0 / 3.0);
          final seg = BezierSegment(current, c1, c2, cmd.target);
          final box = seg.boundingBox;
          minX = math.min(minX, box.minX);
          minY = math.min(minY, box.minY);
          maxX = math.max(maxX, box.maxX);
          maxY = math.max(maxY, box.maxY);
          current = cmd.target;
          break;
        case PathCommandType.cubicTo:
          final seg = BezierSegment(current, cmd.control1, cmd.control2, cmd.target);
          final box = seg.boundingBox;
          minX = math.min(minX, box.minX);
          minY = math.min(minY, box.minY);
          maxX = math.max(maxX, box.maxX);
          maxY = math.max(maxY, box.maxY);
          current = cmd.target;
          break;
        case PathCommandType.close:
          break;
      }
    }

    return Rect2D(minX, minY, maxX, maxY);
  }

  List<Vec2D> toPolyline({double tolerance = 0.5}) {
    final List<Vec2D> points = [];
    Vec2D current = Vec2D.zero;

    for (final cmd in commands) {
      switch (cmd.type) {
        case PathCommandType.moveTo:
          current = cmd.target;
          points.add(current);
          break;
        case PathCommandType.lineTo:
          current = cmd.target;
          points.add(current);
          break;
        case PathCommandType.quadTo:
          final c1 = current + (cmd.control1 - current) * (2.0 / 3.0);
          final c2 = cmd.target + (cmd.control1 - cmd.target) * (2.0 / 3.0);
          final seg = BezierSegment(current, c1, c2, cmd.target);
          final flattened = seg.flatten(tolerance: tolerance);
          points.addAll(flattened.skip(1));
          current = cmd.target;
          break;
        case PathCommandType.cubicTo:
          final seg = BezierSegment(current, cmd.control1, cmd.control2, cmd.target);
          final flattened = seg.flatten(tolerance: tolerance);
          points.addAll(flattened.skip(1));
          current = cmd.target;
          break;
        case PathCommandType.close:
          if (points.isNotEmpty && points.first != current) {
            points.add(points.first);
          }
          break;
      }
    }

    return points;
  }

  Path2D transform(Matrix2D transform) {
    final newPath = Path2D();
    for (final cmd in commands) {
      switch (cmd.type) {
        case PathCommandType.moveTo:
          final pt = transform.transformPoint(cmd.target);
          newPath.moveTo(pt.x, pt.y);
          break;
        case PathCommandType.lineTo:
          final pt = transform.transformPoint(cmd.target);
          newPath.lineTo(pt.x, pt.y);
          break;
        case PathCommandType.quadTo:
          final c1 = transform.transformPoint(cmd.control1);
          final target = transform.transformPoint(cmd.target);
          newPath.quadTo(c1.x, c1.y, target.x, target.y);
          break;
        case PathCommandType.cubicTo:
          final c1 = transform.transformPoint(cmd.control1);
          final c2 = transform.transformPoint(cmd.control2);
          final target = transform.transformPoint(cmd.target);
          newPath.cubicTo(c1.x, c1.y, c2.x, c2.y, target.x, target.y);
          break;
        case PathCommandType.close:
          newPath.close();
          break;
      }
    }
    return newPath;
  }

  Map<String, dynamic> toJson() => {
        'commands': commands.map((c) => c.toJson()).toList(),
      };

  factory Path2D.fromJson(Map<String, dynamic> json) {
    final path = Path2D();
    final list = json['commands'] as List;
    for (final item in list) {
      path.commands.add(PathCommand.fromJson(item));
    }
    return path;
  }
}

