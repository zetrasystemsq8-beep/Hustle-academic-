          id: id,
          name: name,
          visible: visible,
          locked: locked,
          opacity: opacity,
          blendMode: blendMode,
          transform: transform,
          shadow: shadow,
        );

  @override
  Rect2D get localBounds {
    Rect2D box = path.boundingBox;
    if (stroke != null) {
      final pad = stroke!.width / 2.0;
      box = Rect2D(box.minX - pad, box.minY - pad, box.maxX + pad, box.maxY + pad);
    }
    return box;
  }

  @override
  Map<String, dynamic> toJson() => {
        'type': 'vectorShape',
        'id': id,
        'name': name,
        'visible': visible,
        'locked': locked,
        'opacity': opacity,
        'blendMode': blendMode.name,
        'transform': transform.toJson(),
        'shadow': shadow?.toJson(),
        'path': path.toJson(),
        'fill': fill?.toJson(),
