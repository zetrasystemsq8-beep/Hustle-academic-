/// Container/Group node for managing hierarchical graphic scene trees.
class GroupNode extends DesignNode {
  final List<DesignNode> children = [];

  GroupNode({
    required String id,
    required String name,
    bool visible = true,
    bool locked = false,
    double opacity = 1.0,
    BlendMode blendMode = BlendMode.normal,
    Matrix2D? transform,
    DropShadow? shadow,
  }) : super(
          id: id,
          name: name,
          visible: visible,
          locked: locked,
          opacity: opacity,
          blendMode: blendMode,
          transform: transform,
          shadow: shadow,
        );

  void addChild(DesignNode child) {
    children.add(child);
  }

  void removeChild(DesignNode child) {
    children.remove(child);
  }

  @override
  Rect2D get localBounds {
    if (children.isEmpty) return Rect2D.zero;
    Rect2D bounds = children.first.globalBounds;
    for (int i = 1; i < children.length; i++) {
      bounds = bounds.expandToInclude(children[i].globalBounds);
    }
    return bounds;
  }

  @override
  DesignNode? findNodeAt(Vec2D point) {
    if (!visible) return null;
    final inverted = transform.invert();
    if (inverted == null) return null;
    final localPoint = inverted.transformPoint(point);

    for (int i = children.length - 1; i >= 0; i--) {
      final child = children[i];
      if (child is GroupNode) {
        final hit = child.findNodeAt(localPoint);
        if (hit != null) return hit;
      } else if (child.containsPoint(localPoint)) {
        return child;
      }
    }
    return null;
  }

  @override
  Map<String, dynamic> toJson() => {
        'type': 'group',
        'id': id,
        'name': name,
        'visible': visible,
        'locked': locked,
        'opacity': opacity,
        'blendMode': blendMode.name,
        'transform': transform.toJson(),
        'shadow': shadow?.toJson(),
        'children': children.map((c) => c.toJson()).toList(),
      };

  factory GroupNode.fromJson(Map<String, dynamic> json) {
    final group = GroupNode(
      id: json['id'],
      name: json['name'],
      visible: json['visible'] ?? true,
      locked: json['locked'] ?? false,
      opacity: (json['opacity'] as num).toDouble(),
      blendMode: BlendMode.values.byName(json['blendMode']),
      transform: Matrix2D.fromJson(json['transform']),
      shadow: json['shadow'] != null ? DropShadow.fromJson(json['shadow']) : null,
    );

    final childList = json['children'] as List;
    for (final cJson in childList) {
      final type = cJson['type'] as String;
      if (type == 'vectorShape') {
        group.addChild(VectorShapeNode.fromJson(cJson));
      } else if (type == 'text') {
        group.addChild(TextNode.fromJson(cJson));
      } else if (type == 'group') {
        group.addChild(GroupNode.fromJson(cJson));
      }
    }
    return group;
  }
}

extension DesignNodeFindExt on DesignNode {
  DesignNode? findNodeAt(Vec2D point) {
    if (!visible) return null;
    return containsPoint(point) ? this : null;
  }
